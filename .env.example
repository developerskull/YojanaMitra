# ==============================================================================
# YojanaMitra Environment Configuration
# Copy this file to .env.local and fill in your API key.
# Note: YojanaMitra ALSO works in degraded/offline mode without an API key,
# returning grounded scheme cards via hybrid search + deterministic eligibility.
# ==============================================================================

# LLM Provider: "gemini" (default) | "openai" | "anthropic" | "none"
LLM_PROVIDER=gemini

# Primary Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Optional: OpenAI-compatible provider (used if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Anthropic provider (used if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# LLM Reliability Controls
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2

# Stateless Rate Limiting & Cache (in-memory; swap via interfaces for Redis later)
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000
CACHE_MAX_ENTRIES=250
CACHE_TTL_MS=300000

# Authentication (stateless signed HTTP-only cookies; change in production)
AUTH_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
ADMIN_EMAIL=admin@yojanamitra.in
ADMIN_PASSWORD=Admin@1234

# Public App URL (used for metadata & WhatsApp share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Supabase Database (if omitted, YojanaMitra runs in zero-DB in-memory/file mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
